{
  "expo": {
    "name": "ShapeRunr",
    "slug": "ShapeRunr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shaperunr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/shaperunr-runner-icon-coral.png",
      "bundleIdentifier": "com.shaperunr.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3EF",
          "image": "./assets/brand/shaperunr-runner-mark-black-512.png",
          "imageWidth": 170
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShapeRunr uses your location to find nearby running routes and to track your run.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
