PORT=8787

# Local Valhalla HTTP API. Do not point the mobile app at this URL.
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_TIMEOUT_MS=25000

# Paths on the machine that runs Valhalla. The Node backend does not parse the PBF.
OSM_PBF_PATH=./data/custom_files/egypt-latest.osm.pbf
VALHALLA_TILE_DIR=./data/custom_files/valhalla_tiles

# Start may snap to the pedestrian network within this radius.
START_RADIUS_METERS=250

# Target samples farther than this from a pedestrian edge are dropped.
SNAP_RADIUS_METERS=100

# Accept routes within ± this fraction of the requested distance (0.25 → 3–5 km for 4 km).
DISTANCE_TOLERANCE_RATIO=0.25

MAX_RETURNED_ROUTES=3
CANDIDATE_CONCURRENCY=3
